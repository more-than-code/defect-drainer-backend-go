# Copy to backend-go/.env and chmod 600. .env is gitignored; this example is not.
# Never commit a real password. Everything is commented out so a plain copy keeps
# today's SQLite default (an uncommented DATA would point SQLite at a new, empty file).

# sqlite (default, also when empty) or postgres. Anything else fails startup.
# DEFECT_DRAINER_DB_DRIVER=postgres

# Used when the driver is postgres. Placeholder password only.
# Empty falls back to libpq PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE/PGSSLMODE.
# From grok-bot-box, reach pi4 (userspace Tailscale, no tun) via a local relay:
#   socat TCP-LISTEN:15432,bind=127.0.0.1,reuseaddr,fork EXEC:"/home/box/tailscale/tailscale --socket=/home/box/.local/share/tailscale/tailscaled.sock nc 100.87.183.81 5432"
# DEFECT_DRAINER_DATABASE_URL=postgres://postgres:password@127.0.0.1:15432/defect_drainer?sslmode=prefer

# Lock, jobs/, batch-jobs/, clones/. Required in Postgres mode when defect-drainer.db
# is absent, because path auto-detect looks for that SQLite file and does not create a second inventory.
# DEFECT_DRAINER_DATA=/tmp/defect-drainer-data
